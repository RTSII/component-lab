{
  "$comment": "Component Lab core template (core@1). Lab-owned and 100% original (never seed it from licensed code). Every schema-3 component inherits these controls; a component hides what does not apply, overrides labels/ranges/defaults/css, opts into the optional library, and adds its own extras. Tier ids: free | mid | pro (= ga | vip | pro in schema-2 manifests). widget -> lab control: swatches=swatch-role, seg-pads=segmented, pad=switch+pad, switch=switch, h-slider=slider, knob=radial, v-fader=fader+channel, fx-unit=slider+fx, tempo-deck=slider (Pro tempo deck, Mid slider + 0.5/1/2 pads), select / select-compact=select. sizePair (SIZE_W/SIZE_H) keeps the h-slider widget so the value stays a number, but the lab draws a Width|Height mixer switch plus one vertical tempo fader (the tempo-deck strip), not a horizontal slider.",
  "id": "core",
  "version": 1,
  "ref": "core@1",
  "sectionOrder": [
    "color",
    "interact",
    "surface",
    "motion",
    "layout",
    "component"
  ],
  "sectionNote": "Rate merged into Motion (Rob t685u): old 'rate' sections load into Motion; 'type' loads into Layout.",
  "tierOrder": [
    "free",
    "mid",
    "pro"
  ],
  "budget": {
    "free": 6,
    "mid": 22
  },
  "freeRule": "Free = the 4 core colours + 2 freePicks (default GLOW_STRENGTH + RADIUS). Free and Mid controls never sit on a flip-card back.",
  "widgets": [
    "swatches",
    "seg-pads",
    "pad",
    "switch",
    "h-slider",
    "knob",
    "v-fader",
    "fx-unit",
    "tempo-deck",
    "select",
    "select-compact"
  ],
  "overrideWhitelist": [
